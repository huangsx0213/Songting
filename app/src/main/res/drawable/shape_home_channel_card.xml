<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#245679" />
            <stroke android:width="2dp" android:color="@color/color_02F8E1" />
            <corners android:radius="8mm" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#244766" />
            <stroke android:width="1dp" android:color="@color/color_02F8E1" />
            <corners android:radius="8mm" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#DD1C2B40" />
            <corners android:radius="8mm" />
        </shape>
    </item>
</selector>
